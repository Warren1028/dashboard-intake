# Copy to .env.local for local development. Set the same names in Vercel for deployment.

# Supabase (frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase (serverless API, same project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Make.com webhooks (frontend). Each one is required for the feature it names.
VITE_WEBHOOK_URL=                      # Completed-form / Clio send
VITE_SEND_FORM_EMAIL_WEBHOOK=          # Form link email
VITE_REMINDER_WEBHOOK=                 # Overdue reminders
VITE_EMAIL_CONFIRMATION_WEBHOOK=       # Confirmation email on intake completion
VITE_SEND_BACK_WEBHOOK=                # Send-back email (also read by api/send-back-form.js)
VITE_SEND_INQUIRY_FORM_WEBHOOK=        # Inquiry form submission
VITE_SEND_INTAKE_FORM_WEBHOOK=         # Intake form submission
VITE_CLIO_WEBHOOK=                     # Dashboard → Clio

# Make.com webhook (serverless only, not bundled into the browser)
MAKE_CLIO_MULTIPART_WEBHOOK=           # api/send-to-clio-multipart.ts

# App
APP_URL=https://intake.wkointelligence.com   # Public domain used in form links
SKIP_PDF_GENERATION=true                     # Set to false only if LibreOffice is installed
